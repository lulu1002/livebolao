PORT=3000
ADMIN_PASSWORD=troque-esta-senha

# Supabase: Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
